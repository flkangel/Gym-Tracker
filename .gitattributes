# Normalize line endings to LF in the repo; checkout as LF everywhere
# (overrides core.autocrlf on Windows). Shell scripts and Dockerfiles must
# stay LF or the devcontainer breaks on "#!/bin/bash\r".
* text=auto eol=lf
*.sh       text eol=lf
Dockerfile text eol=lf
*.ps1      text eol=crlf
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.svg      text

# Binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
*.zip   binary
*.xlsx  binary
*.xls   binary
