# Copy to `.env` (git-ignored) and fill in. Validated with Zod at startup
# (src/lib/env.ts). Anything prefixed VITE_ ends up in the public bundle.

# --- App (public, bundled) --------------------------------------------------
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Supabase → Project Settings → API Keys → publishable key (sb_publishable_…).
# The legacy "anon" JWT also works. NEVER the secret / service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase CLI (local only, never VITE_, never in Vercel) ----------------
# Personal access token: https://supabase.com/dashboard/account/tokens
# Alternatively run `pnpm exec supabase login` once and leave this empty.
SUPABASE_ACCESS_TOKEN=
# Database password, used by `supabase link` / `db push`.
SUPABASE_DB_PASSWORD=
